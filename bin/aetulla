#!/usr/bin/env bash
# aetulla — one command to update, roll back and inspect the My Aetulla stack.
#   aetulla update            backup -> (git) -> pinned images -> up -> health -> auto-rollback
#   aetulla rollback [DIR]    restore the newest (or given) backup and its previous images
#   aetulla status            versions, health, last backup, Ollama advisory
#   aetulla up                start the core services (named, never a bare `compose up`)
# Env: AETULLA_BACKUP_DIR (default ~/.aetulla/backups)  AETULLA_BACKUP_KEEP (default 3)
#      HEALTH_FORCE_FAIL=svc[,svc]  (testing the rollback path)
set -o pipefail
AET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export AET_ROOT
# shellcheck disable=SC1091  # path is computed from this script's location
source "$AET_ROOT/lib/aetulla.sh"

case "${1:-}" in
    update)   cmd_update ;;
    rollback) shift; cmd_rollback "$@" ;;
    status)   cmd_status ;;
    up)       cmd_up ;;
    *)        sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
