#!/usr/bin/env bash
# aetulla — one command to update, roll back and inspect the My Aetulla stack.
#   aetulla update [--channel latest|locked] [--dry-run] [--with-ollama] [--no-models]
#                  [--only keepalive,build,playwright,n8n,open-webui,mem0,ollama,models,qdrant] [--yes] [--yes-big] [--qdrant-to X.Y.Z]
#                             backup -> (git) -> pinned images -> up -> health -> auto-rollback
#                             --dry-run: show current -> target per component, change nothing
#   aetulla rollback [DIR]    restore the newest (or given) backup and its previous images
#   aetulla status            versions, health, last backup, Ollama advisory
#   aetulla up                start the core services on resolved.lock's versions (named, never a bare `compose up`)
#   aetulla lock --promote    after a fully healthy run: versions.lock + compose defaults := what is installed
# Env: AETULLA_BACKUP_DIR (default ~/.aetulla/backups)  AETULLA_BACKUP_KEEP (default 3)
#      HEALTH_FORCE_FAIL=svc[,svc]  (testing the rollback path)
set -o pipefail
AET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export AET_ROOT
# shellcheck disable=SC1091  # path is computed from this script's location
source "$AET_ROOT/lib/aetulla.sh"

case "${1:-}" in
    update)   shift; cmd_update "$@" ;;
    rollback) shift; cmd_rollback "$@" ;;
    status)   cmd_status ;;
    up)       cmd_up ;;
    lock)     shift; cmd_lock "$@" ;;
    *)        sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
