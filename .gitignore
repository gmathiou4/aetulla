# ── Allowlist: ignore everything at the top level, then allow only what the kit needs ──
/*
!/.gitignore
!/README.md
!/LICENSE
!/.env.example
!/setup.sh
!/docker-compose.yml
!/Dockerfile.mem0
!/memory.py.patched
!/config.py.patched
!/categorization.py.patched
!/assets/
!/bin/
!/installer/
!/lib/
!/openwebui/
!/playwright/
!/stt/
!/tts/
!/web-extractor/

# ── Never, even inside allowed folders ──
CLAUDE*.md
.claude/
*.bak*
*.log
__pycache__/
*:Zone.Identifier
installer/smoke_test_notes.md
.env
.env.*
!/.env.example
bin/updatedeep.sh
bin/update.sh
